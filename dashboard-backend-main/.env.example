# Variáveis de ambiente do ecossistema Globo2-PE.
# Lido automaticamente pelo `docker compose` (docker-compose.yml usa
# ${VAR:-default}, então mesmo sem este arquivo os valores padrão abaixo
# continuam funcionando).
#
# NÃO commitar este arquivo com credenciais reais de produção — ele está
# no .gitignore. Use .env.example como referência para outros ambientes.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=globo2_db
DB_USER=globo_user
DB_PASSWORD=123456

REDIS_HOST=redis
REDIS_PORT=6379

PREDICTOR_URL=http://data_ia:5001
